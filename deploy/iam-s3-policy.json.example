{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDocumentPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::inventory-billing-prod-documents-2026",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["documents/*"]
        }
      }
    },
    {
      "Sid": "ObjectReadWriteDelete",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::inventory-billing-prod-documents-2026/documents/*"
    }
  ]
}
