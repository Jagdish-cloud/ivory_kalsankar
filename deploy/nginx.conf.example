# Nginx reverse proxy for the Ivory Lace API on EC2.
# TLS for the public hostname should terminate at CloudFront / ACM.
# This server only needs to speak HTTP to CloudFront (or HTTPS if you attach a cert here).

upstream ivory_lace_api {
    server 127.0.0.1:4100;
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name api.example.com;

    client_max_body_size 12m;
    client_body_timeout 90s;

    gzip on;
    gzip_types application/json text/plain application/javascript;

    location /api/health {
        proxy_pass http://ivory_lace_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    location /api/ {
        proxy_pass http://ivory_lace_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Store-Id $http_x_store_id;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}
