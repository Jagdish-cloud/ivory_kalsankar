NODE_ENV=production
# RDS: add connection_limit (~10 per Node process) and sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_RDS_HOST:5432/ivory_lace?schema=public&connection_limit=10&pool_timeout=20&sslmode=require"
JWT_SECRET="generate-a-random-string-at-least-32-characters"
JWT_EXPIRES_IN="7d"
PORT=4100
# Comma-separated if you need more than one browser origin
CORS_ORIGIN="https://app.example.com"
APP_PUBLIC_URL="https://app.example.com"
LOG_LEVEL="info"
REQUEST_TIMEOUT_MS=90000
ENABLE_LOCAL_UPLOADS=false

AWS_REGION="ap-south-1"
S3_BUCKET="inventory-billing-prod-documents-2026"
S3_DOCUMENTS_PREFIX="documents/"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Ivory Lace <no-reply@example.com>"
DEFAULT_EMAIL_RECIPIENT=""
LOW_STOCK_CRON="0 21 * * *"
CRON_TZ="Asia/Kolkata"

# Do not set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here.
# Production uses the EC2 instance role.
