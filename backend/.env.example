NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ivory_lace?schema=public"
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4100
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL="debug"
REQUEST_TIMEOUT_MS=90000

# Public URL of the web app (embedded in the QR code printed on every invoice)
APP_PUBLIC_URL="http://localhost:5173"

# Shared company GSTIN is stored in the AppSetting table (Settings page).
# APP_GSTIN is only used as a one-time fallback if the table is empty.
APP_GSTIN=""

SEED_USER_EMAIL="anjali@ivorylace.in"
SEED_USER_PASSWORD="replace-me"
SEED_ADMIN_EMAIL="admin@ivorylace.in"
SEED_ADMIN_PASSWORD="replace-me"

# Email (bill copies + end-of-day low stock report). For Gmail use smtp.gmail.com / 587 and an App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Ivory Lace <your-address@gmail.com>"
DEFAULT_EMAIL_RECIPIENT=""

# End-of-day low stock email (cron, in CRON_TZ)
LOW_STOCK_CRON="0 21 * * *"
CRON_TZ="Asia/Kolkata"

# Private S3 document storage. Credentials come from the AWS default provider chain
# (local: `aws configure`; production: EC2 instance role). Do not put access keys here.
AWS_REGION="ap-south-1"
S3_BUCKET=""
# AWS_S3_BUCKET is accepted as an alias for S3_BUCKET.
S3_DOCUMENTS_PREFIX="documents/"

# Serve legacy local files from backend/uploads (development only).
ENABLE_LOCAL_UPLOADS=true
