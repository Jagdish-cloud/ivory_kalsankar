NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ivory_lace?schema=public"
JWT_SECRET="dev-only-change-me-use-a-long-random-string"
JWT_EXPIRES_IN="100y"
PORT=4100
CORS_ORIGIN="http://localhost:5173"
APP_PUBLIC_URL="http://localhost:5173"
LOG_LEVEL="debug"
REQUEST_TIMEOUT_MS=90000
ENABLE_LOCAL_UPLOADS=true
AWS_REGION="ap-south-1"
S3_BUCKET=""
S3_DOCUMENTS_PREFIX="documents/"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
LOW_STOCK_CRON="0 21 * * *"
CRON_TZ="Asia/Kolkata"
